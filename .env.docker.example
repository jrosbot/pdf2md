# Local Docker test defaults. Do not use these settings for a public deployment.
PDF2MD_ENV=development
PDF2MD_PORT=8000
PDF2MD_PUBLIC_BASE_URL=http://localhost:8000
PDF2MD_ISSUER_URL=http://localhost:8000
PDF2MD_RESOURCE_URL=http://localhost:8000/mcp
PDF2MD_SESSION_SECRET=local-development-only-change-me

# Leave provider and Brevo values blank for the health check only.
PDF2MD_GOOGLE_CLIENT_ID=
PDF2MD_GOOGLE_CLIENT_SECRET=
PDF2MD_MICROSOFT_CLIENT_ID=
PDF2MD_MICROSOFT_CLIENT_SECRET=
PDF2MD_APPLE_CLIENT_ID=
PDF2MD_APPLE_CLIENT_SECRET=
PDF2MD_BREVO_API_KEY=
PDF2MD_EMAIL_FROM=
PDF2MD_EMAIL_FROM_NAME=PDF2MD

# Limits: 25 MiB per PDF, 100 MiB per PDF2MD account per UTC day.
PDF2MD_MAX_FILE_BYTES=26214400
PDF2MD_DAILY_QUOTA_BYTES=104857600
