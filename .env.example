# Public URLs. They must be HTTPS in production.
PDF2MD_ENV=production
PDF2MD_PUBLIC_BASE_URL=https://mcp.example.com
PDF2MD_ISSUER_URL=https://mcp.example.com
PDF2MD_RESOURCE_URL=https://mcp.example.com/mcp
PDF2MD_DATABASE_PATH=/data/pdf2md.sqlite3
PDF2MD_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: restrict ChatGPT's signed file download hosts. Use the exact hosts
# supplied by the deployment's file service, separated by commas.
PDF2MD_ALLOWED_DOWNLOAD_HOSTS=

# Identity provider credentials. Register each callback URL as:
# https://mcp.example.com/oauth/callback/google
# https://mcp.example.com/oauth/callback/microsoft
# https://mcp.example.com/oauth/callback/apple
PDF2MD_GOOGLE_CLIENT_ID=
PDF2MD_GOOGLE_CLIENT_SECRET=
PDF2MD_MICROSOFT_CLIENT_ID=
PDF2MD_MICROSOFT_CLIENT_SECRET=
PDF2MD_APPLE_CLIENT_ID=
PDF2MD_APPLE_CLIENT_SECRET=

# Email/password sign-in is shown only when both Brevo settings are present.
PDF2MD_BREVO_API_KEY=
PDF2MD_EMAIL_FROM=
PDF2MD_EMAIL_FROM_NAME=PDF2MD

# Email links need time to be opened. OAuth and verification flows expire after 30 minutes.
PDF2MD_OAUTH_STATE_TTL=1800

# Deliberate product limits: 25 MiB per PDF, 100 MiB per account per UTC day.
PDF2MD_MAX_FILE_BYTES=26214400
PDF2MD_DAILY_QUOTA_BYTES=104857600

